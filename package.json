{
  "name": "meshari-ongoing-charity",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:clean": "npm run clean:all && npm run dev",
    "build": "next build",
    "build:turbo": "NEXT_TURBOPACK=1 next build",
    "build:analyze": "ANALYZE=true next build",
    "build:clean": "npm run clean:all && npm run build",
    "start": "next start",
    "lint": "node -r ./scripts/use-typescript6.cjs ./node_modules/eslint/bin/eslint.js . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "node -r ./scripts/use-typescript6.cjs ./node_modules/eslint/bin/eslint.js . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:all": "rm -rf .next node_modules package-lock.json .turbo .swc && npm cache clean --force",
    "clean:build": "./scripts/clean-build.sh"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.1.0-0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "next": "^16.3.0-preview.10",
    "next-devtools-mcp": "^0.4.0",
    "pdfjs-dist": "^5.4.530",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.5.1",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0-preview.10",
    "@next/playwright": "^16.3.0-preview.10",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0-preview.10",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "typescript6": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "postcss": "^8.5.25",
    "react-pdf": {
      "pdfjs-dist": "5.4.530"
    }
  }
}
