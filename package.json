{
  "name": "meshari-ongoing-charity",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:clean": "npm run clean:all && npm run dev",
    "build": "next build",
    "build:turbo": "NEXT_TURBOPACK=1 next build",
    "build:analyze": "ANALYZE=true next build",
    "build:clean": "npm run clean:all && npm run build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:all": "rm -rf .next node_modules package-lock.json .turbo .swc && npm cache clean --force",
    "clean:build": "./scripts/clean-build.sh",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.1.0-0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-devtools-mcp": "^0.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.1",
    "next-sitemap": "^4.2.3",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.24.0"
  }
}
