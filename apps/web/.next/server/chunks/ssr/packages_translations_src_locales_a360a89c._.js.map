ng_1":"Kami telah mencapai pagi dan pada saat ini semua kedaulatan milik Allah. Segala puji bagi Allah. Tidak ada tuhan selain Allah, Dia esa, tidak ada sekutu bagi-Nya. Kepada-Nya milik kerajaan dan kepada-Nya segala puji, dan Dia berkuasa atas segala sesuatu","supplications.morning_2":"Ya Allah, dengan-Mu kami mencapai pagi, dengan-Mu kami mencapai sore, dengan-Mu kami hidup, dengan-Mu kami mati, dan kepada-Mu adalah kembali","supplications.morning_3":"Ya Allah, kami telah mencapai pagi dan kami bersaksi kepada-Mu dan kepada para pembawa Arsy-Mu dan para malaikat-Mu dan semua makhluk-Mu bahwa Engkau adalah Allah, tidak ada tuhan selain Engkau sendiri, Engkau tidak memiliki sekutu, dan bahwa Muhammad adalah hamba-Mu dan utusan-Mu","supplications.evening_1":"Kami telah mencapai sore dan pada saat ini semua kedaulatan milik Allah. Segala puji bagi Allah. Tidak ada tuhan selain Allah, Dia esa, tidak ada sekutu bagi-Nya. Kepada-Nya milik kerajaan dan kepada-Nya segala puji, dan Dia berkuasa atas segala sesuatu","supplications.evening_2":"Ya Allah, dengan-Mu kami mencapai sore, dengan-Mu kami mencapai pagi, dengan-Mu kami hidup, dengan-Mu kami mati, dan kepada-Mu adalah tujuan","dhikr.tasbih":"Tasbih","supplications.guidance":"Bimbingan","supplications.forgiveness":"Pengampunan","supplications.gratitude":"Syukur","supplications.sleep":"Tidur","supplications.waking":"Bangun","dhikr.auto_saved":"Tersimpan otomatis","islamic_chant":{"title":"Lagu Islam Favorit Meshari","description":"Lagu Islam yang indah yang sangat disukai Meshari, membawa kedamaian dan ketenangan"},"quran_verse":{"bismillah":"Dengan nama Allah, Yang Maha Pengasih, Maha Penyayang","verse":"Dan berikan kabar gembira kepada orang-orang yang sabar, yang apabila ditimpa musibah, mereka mengucapkan: 'Sesungguhnya kami milik Allah dan kepada-Nya kami akan kembali.' Mereka itulah yang mendapat keberkahan dan rahmat dari Tuhan mereka. Dan mereka itulah orang-orang yang mendapat petunjuk.","sadaqallah":"Allah Yang Maha Tinggi dan Maha Agung telah berfirman dengan benar"},"social":{"x_account":"Akun X","github":"GitHub"},"navigation":{"sections_title":"Bagian yang Tersedia","sections_description":"Jelajahi berbagai bagian situs web, setiap bagian memiliki halaman terpisah yang dapat diakses langsung","visit_section":"Kunjungi Bagian","back_to_home":"Kembali ke Beranda"},"navigation.visit_section":"Kunjungi Bagian","navigation.back_to_home":"Kembali ke Beranda","navigation.sections_title":"Bagian yang Tersedia","navigation.sections_description":"Jelajahi berbagai bagian situs web, setiap bagian memiliki halaman terpisah yang dapat diakses langsung","quran_stories.featured_story":"Cerita Unggulan","quran_stories.preview":"Pratinjau","quran_stories.read":"Baca","location.riyadh":"Riyadh","location.saudi_arabia":"Arab Saudi","donation.balance_text":"Semoga Allah meletakkannya dalam timbangan kebaikannya","qibla.find_direction":"Cari Arah Kiblat","qibla.detecting_location":"Mendeteksi lokasi Anda...","qibla.please_allow":"Silakan izinkan akses lokasi jika diminta","qibla.retry":"Coba Lagi","qibla.refresh":"Coba Lagi","quran_stories.title":"Kisah Al-Quran","quran_stories.description":"Temukan kisah-kisah indah di balik setiap surah Al-Quran","quran_stories.download":"Unduh","meshari_favorite_reciter.title":"Pembaca Al-Quran Favorit Meshari","meshari_favorite_reciter.subtitle":"Dengarkan Al-Quran dengan pembaca favorit Meshari (Semoga Allah merahmatinya)","islamic_chant.title":"Lagu Islami Favorit Meshari","islamic_chant.subtitle":"Lagu islami yang indah yang sangat disukai Meshari, membawa kedamaian dan ketenangan"}