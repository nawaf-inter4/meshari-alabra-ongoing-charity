{
  "status": 200,
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/page,_N_T_/ko"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/__PAGE__",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}