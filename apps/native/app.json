{
  "expo": {
    "name": "Meshari's Continuous Charity",
    "slug": "meshari-charity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "meshari-charity",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meshari.charity",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "We need your location to provide accurate prayer times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to provide accurate prayer times even when the app is in the background."
      },
      "tv": {
        "enabled": true,
        "requiresFullScreen": false
      },
      "watch": {
        "enabled": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.meshari.charity",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "tv": {
        "enabled": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Meshari's Charity to use your location for prayer times."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D4AF37",
          "sounds": ["./assets/athan.mp3"]
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
