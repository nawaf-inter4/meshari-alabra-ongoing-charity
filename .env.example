# =============================================================================
# Memorial / white-label settings
# =============================================================================
# Copy to .env.local for local use, or paste the keys into your host’s
# Environment Variables panel (Vercel, Netlify, Render, Railway, CranL,
# Coolify, Dokploy, Docker, etc.).
#
# Never commit .env, .env.local, provider tokens, or private keys.
# NEXT_PUBLIC_* values are visible in the browser — never put secrets here.
#
# Minimum for a new memorial site:
#   1) NEXT_PUBLIC_SITE_URL          → your final HTTPS address (no trailing /)
#   2) NEXT_PUBLIC_SITE_NAME         → full site title
#   3) NEXT_PUBLIC_SITE_SHORT_NAME   → short name (PWA / home screen)
#   4) NEXT_PUBLIC_MEMORIAL_NAME     → visible memorial heading
#   5) NEXT_PUBLIC_DONATION_URL      → donate button destination
#   6) NEXT_PUBLIC_COLOR_BRAND / ACCENT → brand colors
#
# After changing any NEXT_PUBLIC_* value on a host, rebuild / redeploy.
# Docker: docker compose --env-file .env.local up --build
# Full guide: WHITE_LABELING.md · Deploy steps: DEPLOYMENT.md
# =============================================================================

# Core identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Meshari's Ongoing Charity - صدقة جارية لمشاري"
NEXT_PUBLIC_SITE_SHORT_NAME="Meshari's Charity"
NEXT_PUBLIC_ORGANIZATION_NAME="Meshari's Ongoing Charity"
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DEFAULT_DIRECTION=rtl

# White-label assets (local public/ paths or absolute URLs)
NEXT_PUBLIC_LOGO_PATH=/icons/icon-512x512.png
NEXT_PUBLIC_LOGO_LIGHT_PATH=/logo-light.svg
NEXT_PUBLIC_LOGO_DARK_PATH=/logo-dark.svg
NEXT_PUBLIC_FAVICON_PATH=/favicon.svg
NEXT_PUBLIC_APPLE_TOUCH_ICON_PATH=/icons/apple-icon-180.png
NEXT_PUBLIC_PWA_ICON_192_PATH=/icons/icon-192x192.png
NEXT_PUBLIC_PWA_ICON_512_PATH=/icons/icon-512x512.png
NEXT_PUBLIC_PWA_MASKABLE_ICON_PATH=/icons/icon-maskable-512x512.png
NEXT_PUBLIC_OG_IMAGE_PATH=/og-image.png
NEXT_PUBLIC_SUPPLICATIONS_PDF_PATH="/mehsari (دعاء).pdf"

# SEO and social identity
# Leave SEO title/description empty to keep the built-in localized metadata.
NEXT_PUBLIC_SEO_TITLE=
NEXT_PUBLIC_SEO_DESCRIPTION=
NEXT_PUBLIC_SEO_KEYWORDS=
NEXT_PUBLIC_SOCIAL_HANDLE=@alabrameshari

# Optional content overrides (empty values keep localized translations)
NEXT_PUBLIC_MEMORIAL_LEGAL_NAME="Meshari Ahmed Sulaiman Alabra"
NEXT_PUBLIC_MEMORIAL_NAME=
NEXT_PUBLIC_MEMORIAL_ALTERNATE_NAME="مشاري بن أحمد بن سليمان العبره"
NEXT_PUBLIC_MEMORIAL_DEATH_DATE=2023-03-29
NEXT_PUBLIC_MEMORIAL_DATE_TEXT=
NEXT_PUBLIC_HERO_DESCRIPTION=
NEXT_PUBLIC_FOOTER_CHARITY_TEXT=
NEXT_PUBLIC_DONATION_URL=https://ehsan.sa/campaign/6FC11E15DA
NEXT_PUBLIC_QURAN_PLAYLIST_ID=PLozaqJ9egxJegXbK52PNLLlvWf4K5g-Cb
NEXT_PUBLIC_QURAN_PLAYLIST_START_VIDEO_ID=VXb36Nzybps
NEXT_PUBLIC_FAVORITE_RECITER_PLAYLIST_ID=PLA3B14EC1634EA167
NEXT_PUBLIC_FAVORITE_RECITER_START_VIDEO_ID=VzsvG9K1qqQ
NEXT_PUBLIC_ISLAMIC_CHANT_VIDEO_ID=1yP3UPr-L20
NEXT_PUBLIC_SOCIAL_LINKS=

# Location and prayer-time fallback used only when live lookup fails
NEXT_PUBLIC_FALLBACK_LATITUDE=24.7136
NEXT_PUBLIC_FALLBACK_LONGITUDE=46.6753
NEXT_PUBLIC_FALLBACK_CITY=Riyadh
NEXT_PUBLIC_FALLBACK_COUNTRY="Saudi Arabia"
NEXT_PUBLIC_FALLBACK_COUNTRY_CODE=SA
NEXT_PUBLIC_FALLBACK_FAJR="5:15 AM"
NEXT_PUBLIC_FALLBACK_SUNRISE="6:30 AM"
NEXT_PUBLIC_FALLBACK_DHUHR="12:00 PM"
NEXT_PUBLIC_FALLBACK_ASR="3:30 PM"
NEXT_PUBLIC_FALLBACK_MAGHRIB="6:00 PM"
NEXT_PUBLIC_FALLBACK_ISHA="7:30 PM"

# Theme colors
NEXT_PUBLIC_COLOR_BRAND="#D4AF37"
NEXT_PUBLIC_COLOR_ACCENT="#006B3F"
NEXT_PUBLIC_COLOR_LINK="#0066B2"
NEXT_PUBLIC_COLOR_BACKGROUND_DARK="#0F172A"
NEXT_PUBLIC_COLOR_BACKGROUND_DARK_SECONDARY="#1E293B"
NEXT_PUBLIC_COLOR_BACKGROUND_DARK_ACCENT="#334155"
NEXT_PUBLIC_COLOR_BACKGROUND_LIGHT="#FAF8F3"
NEXT_PUBLIC_COLOR_BACKGROUND_LIGHT_SECONDARY="#F5F3EE"
NEXT_PUBLIC_COLOR_BACKGROUND_LIGHT_ACCENT="#E8E5DD"

# PWA
NEXT_PUBLIC_PWA_ID=meshari-charity-pwa
NEXT_PUBLIC_PWA_START_URL=/

# Optional push notifications (replace placeholders only in your private env)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: enable only when deploying with Vercel Analytics configured
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
